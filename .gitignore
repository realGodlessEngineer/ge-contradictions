# --- Dependencies ---
node_modules/

# --- Python bytecode ---
__pycache__/
*.pyc

# --- Secrets / local machine config ---
.env
**/.env
.claude/settings.local.json

# --- Database binaries ---
# The DB is versioned as a diff-friendly SQL snapshot (db/schema.sql + db/data.sql)
# and rebuilt with `node .scripts/buildDbFromSql.js`. The binaries are not tracked.
# This also excludes the two large foreign artifacts (bible_reference.db ~397 MB,
# study-bundle.db ~176 MB) that exceed GitHub's file-size limit and are unrelated to
# this project's pipeline.
*.db

# --- Database backups ---
.archive/
*.bak
*.bak-*

# --- DRY_RUN / working artifacts (regenerated by scripts; not source) ---
data/harmonization/curation/_bake_preview.json
data/scholarship_parse_preview.json

# --- T9/T10 bundle caches (regenerable: fetchWell.js + buildT{9,10}Bundles.js) ---
data/harmonization/curation/_t10bundles/
data/harmonization/curation/_t9bundles/
data/harmonization/curation/_t9pilot/

# --- Transient T12-T15 working lists (regenerable scratch; kept: _parity_waivers.json,
#     _t11_subset.json, _t12_probe_results.json, _t15_residual.json are provenance) ---
data/harmonization/curation/_t12_probe_ids.json
data/harmonization/curation/_t13_worklist.json
data/harmonization/curation/_t14_worklist.json
data/harmonization/curation/_t14_authored.json
data/harmonization/curation/_t14_audit_rejected.json
data/harmonization/curation/_t14_revert.json
data/harmonization/curation/_t15_waive.json

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
*.log
