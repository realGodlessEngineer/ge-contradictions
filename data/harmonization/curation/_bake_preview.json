  "rows": [
    {
      "contradiction_id": 3,
      "covered": 1,
      "reconcile_note": "Clarke identifies Job's 'morning stars' with the angelic host created alongside the 'heavens' of Genesis 1:1, not the literal stars of day four.",
      "reconcile_half_line": "This pole reads Job's morning stars as an angelic host present at creation, not literal stars formed on Genesis' fourth day.",
      "reconcile_empty_note": null,
      "reconcile_empty_note_attr": null,
      "discrepancy_note": "Keil, Delitzsch, and the Pulpit Commentary read Job's 'morning stars' as actual stars present at creation, keeping Genesis' fourth-day timeline in tension.",
      "discrepancy_half_line": "These commentators take Job's morning stars as literal stars already shining at creation, holding Genesis' fourth-day sequence in tension.",
      "discrepancy_empty_note": null,
      "discrepancy_empty_note_attr": null
    },
    {
      "contradiction_id": 4,
      "covered": 1,
      "reconcile_note": "Clarke distinguishes the diffused day-one light from the sun and stars later constituted as its light-bearers on day four.",
      "reconcile_half_line": null,
      "reconcile_empty_note": null,
      "reconcile_empty_note_attr": null,
      "discrepancy_note": "Paine objects that Genesis places three days and nights, with evenings and mornings, before any sun exists to cause them.",
      "discrepancy_half_line": null,
      "discrepancy_empty_note": null,
      "discrepancy_empty_note_attr": null
    },
    {
      "contradiction_id": 189,
      "covered": 1,
      "reconcile_note": "Augustine reads Matthew's account as crediting the centurion with an approach carried out through intermediaries, a compendious form of speech.",
      "reconcile_half_line": null,
      "reconcile_empty_note": null,
      "reconcile_empty_note_attr": null,
      "discrepancy_note": "Strauss insists that Matthew has the centurion approach in person while Luke has him send messengers throughout, calling the two accounts irreconcilable.",
      "discrepancy_half_line": null,
      "discrepancy_empty_note": null,
      "discrepancy_empty_note_attr": null
    },
    {
      "contradiction_id": 439,
      "covered": 1,
      "reconcile_note": "Gill reads Luke's eight days as inclusive of the day of the saying and the day of the transfiguration, while Matthew and Mark count only the days between.",
      "reconcile_half_line": null,
      "reconcile_empty_note": null,
      "reconcile_empty_note_attr": null,
      "discrepancy_note": null,
      "discrepancy_half_line": null,
      "discrepancy_empty_note": "No major public-domain critic presses this as a contradiction — and the leading 19th-c. skeptic, D. F. Strauss, calls the agreement \"certainly striking\" and reconciles the numbers himself.",
      "discrepancy_empty_note_attr": "D. F. Strauss (d. 1874), The Life of Jesus Critically Examined (1846)."
    },
    {
      "contradiction_id": 459,
      "covered": 1,
      "reconcile_note": "Henry reads the stop at Annas as a brief consultative halt before Jesus was sent on to Caiaphas, where the Synoptic trial took place.",
      "reconcile_half_line": null,
      "reconcile_empty_note": null,
      "reconcile_empty_note_attr": null,
      "discrepancy_note": "Strauss treats the synoptic 'high priest' and John's Annas as first stops that cannot both be true, calling the accounts flatly at odds.",
      "discrepancy_half_line": null,
      "discrepancy_empty_note": null,
      "discrepancy_empty_note_attr": null
    },
    {
      "contradiction_id": 468,
      "covered": 1,
      "reconcile_note": "Clarke reads John and the Synoptics as one sequence: Jesus carried the cross himself until weakness required Simon's help.",
      "reconcile_half_line": null,
      "reconcile_empty_note": null,
      "reconcile_empty_note_attr": null,
      "discrepancy_note": "Strauss notes that John has Jesus carry his own cross while the Synoptics substitute Simon, treating the usual harmonizing move as an unproven assumption.",
      "discrepancy_half_line": null,
      "discrepancy_empty_note": null,
      "discrepancy_empty_note_attr": null
    },
    {
      "contradiction_id": 496,
      "covered": 1,
      "reconcile_note": "Clarke reads John's single mention of Mary Magdalene as selective focus, while the Synoptics report additional women at the tomb.",
      "reconcile_half_line": null,
      "reconcile_empty_note": null,
      "reconcile_empty_note_attr": null,
      "discrepancy_note": "Paine contrasts Luke's several named women with John's Mary Magdalene alone, taking the mismatch as evidence the resurrection accounts do not agree.",
      "discrepancy_half_line": null,
      "discrepancy_empty_note": null,
      "discrepancy_empty_note_attr": null
    }
  ],
  "quotes": [
    {
      "contradiction_id": 3,
      "pole": "reconcile",
      "text": "This must refer to some intelligent beings who existed before the creation of the visible heavens and earth: and it is supposed that this and the following clause refer to the same beings; that by the sons of God, and the morning stars, the angelic host is meant… Perhaps their creation may be included in the term heavens, Gen 1:1: “In the beginning God created the heavens and the earth.”",
      "attr": "Adam Clarke (1832), Commentary on the Bible, on Job 38:7.",
      "voice": null,
      "href": null,
      "source_kind": "machine",
      "source_code": "CLARKE",
      "ord": 0,
      "id": 1
    },
    {
      "contradiction_id": 3,
      "pole": "reconcile",
      "text": "when the morning-stars sang together, the blessed angels (the first-born of the Father of light), who, in the morning of time, shone as brightly as the morning star, going immediately before the light which God commanded to shine out of darkness upon the seeds of this lower world, the earth, which was without form and void.",
      "attr": "Matthew Henry (1706-1714), Commentary on the Whole Bible, on Job 38:7.",
      "voice": null,
      "href": null,
      "source_kind": "machine",
      "source_code": "MHC",
      "ord": 1,
      "id": 2
    },
    {
      "contradiction_id": 3,
